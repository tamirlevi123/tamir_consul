# This file tells systemd how to run Puma as a 24/7 long-running daemon.
#
# Customize this file based on your bundler location, app directory, etc.
# Customize and copy this into /usr/lib/systemd/system (CentOS) or /lib/systemd/system (Ubuntu).
# Then run:
#   - systemctl enable <%= fetch(:puma_service_unit_name) %>
#   - systemctl {start,stop,restart} <%= fetch(:puma_service_unit_name) %>
#
#
# Use `journalctl -u <%= fetch(:puma_service_unit_name) %> -rn 100` to view the last 100 lines of log output.
#
[Unit]
Description=Puma HTTP Server for <%= "#{fetch(:application)} (#{fetch(:stage)})" %>
After=network.target

[Service]
Type=simple
WatchdogSec=0

WorkingDirectory=<%= current_path %>
Environment=PATH=<%= fetch(:rvm_custom_path, '/home/deploy/.rvm') %>/gems/ruby-<%= fetch(:rvm_ruby_version, '3.3.8') %>/bin:<%= fetch(:rvm_custom_path, '/home/deploy/.rvm') %>/gems/ruby-<%= fetch(:rvm_ruby_version, '3.3.8') %>@global/bin:<%= fetch(:rvm_custom_path, '/home/deploy/.rvm') %>/rubies/ruby-<%= fetch(:rvm_ruby_version, '3.3.8') %>/bin:<%= fetch(:rvm_custom_path, '/home/deploy/.rvm') %>/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=GEM_HOME=<%= shared_path %>/bundle
Environment=BUNDLE_PATH=<%= shared_path %>/bundle
Environment=RAILS_ENV=<%= fetch(:rails_env) %>
Environment=RACK_ENV=<%= fetch(:rails_env) %>
Environment=BUNDLE_GEMFILE=<%= current_path %>/Gemfile

ExecStart=<%= fetch(:rvm_custom_path, '/home/deploy/.rvm') %>/rubies/ruby-<%= fetch(:rvm_ruby_version, '3.3.8') %>/bin/bundle exec puma -C config/puma/<%= fetch(:rails_env) %>.rb
ExecReload=/bin/kill -USR1 $MAINPID

RestartSec=1
Restart=on-failure

StandardOutput=append:<%= shared_path %>/log/puma_access.log
StandardError=append:<%= shared_path %>/log/puma_error.log

SyslogIdentifier=puma

[Install]
WantedBy=default.target
