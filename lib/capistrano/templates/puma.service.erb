# This file tells systemd how to run Puma as a 24/7 long-running daemon.
#
# Customize this file based on your bundler location, app directory, etc.
# Customize and copy this into /usr/lib/systemd/system (CentOS) or /lib/systemd/system (Ubuntu).
# Then run:
#   - systemctl enable <%= fetch(:puma_service_unit_name) %>
#   - systemctl {start,stop,restart} <%= fetch(:puma_service_unit_name) %>
#
#
# Use `journalctl -u <%= fetch(:puma_service_unit_name) %> -rn 100` to view the last 100 lines of log output.
#
[Unit]
Description=Puma HTTP Server for <%= "#{fetch(:application)} (#{fetch(:stage)})" %>
<%= "Requires=#{fetch(:puma_service_unit_name)}.socket" if fetch(:puma_enable_socket_service) %>
After=network.target

[Service]
Type=simple
WatchdogSec=0

WorkingDirectory=<%= current_path %>
Environment=PATH=/home/azureuser/.rvm/gems/ruby-3.3.8/bin:/home/azureuser/.rvm/gems/ruby-3.3.8@global/bin:/home/azureuser/.rvm/rubies/ruby-3.3.8/bin:/home/azureuser/.rvm/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=GEM_HOME=/home/azureuser/apps/consul231/shared/bundle
Environment=BUNDLE_PATH=/home/azureuser/apps/consul231/shared/bundle
Environment=RAILS_ENV=testing
Environment=RACK_ENV=testing

ExecStart=/home/azureuser/.rvm/gems/ruby-3.3.8/bin/bundle exec puma -C config/puma/testing.rb
ExecReload=/bin/kill -USR1 $MAINPID

RestartSec=1
Restart=on-failure

StandardOutput=append:/home/azureuser/apps/consul231/shared/log/puma_access.log
StandardError=append:/home/azureuser/apps/consul231/shared/log/puma_error.log

SyslogIdentifier=puma

[Install]
WantedBy=default.target
